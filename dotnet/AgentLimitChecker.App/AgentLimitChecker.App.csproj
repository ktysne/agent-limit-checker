<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AgentLimitChecker</AssemblyName>
    <!-- WPF が主のプロセスなので、WinForms の API ではなくマニフェストで Per-Monitor V2 を宣言する。 -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF の型(Control、Application など)と衝突するので、WinForms の型は別名 Forms で参照する。 -->
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <!-- トレイ用に、表示倍率に合う大きさの画像を ico から直接選ぶ。 -->
    <EmbeddedResource Include="app.ico" LogicalName="AgentLimitChecker.app.ico" />
  </ItemGroup>

  <PropertyGroup>
    <Version Condition="'$(Version)' == ''">4.0.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentLimitChecker.Core\AgentLimitChecker.Core.csproj" />
  </ItemGroup>
</Project>
