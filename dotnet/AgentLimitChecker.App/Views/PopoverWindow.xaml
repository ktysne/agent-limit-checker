<Window x:Class="AgentLimitChecker.App.Views.PopoverWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:vm="clr-namespace:AgentLimitChecker.App.ViewModels"
 Width="360" MinHeight="200" MaxHeight="900" SizeToContent="Height"
 WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
 AllowsTransparency="False" UseLayoutRounding="True"
 TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
 Background="{DynamicResource Bg}" Foreground="{DynamicResource Text}"
 Deactivated="OnDeactivated" PreviewKeyDown="OnPreviewKeyDown">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/>
   <Setter Property="LineHeight" Value="16"/>
  </Style>
  <Style x:Key="IconButton" TargetType="Button">
   <Setter Property="Padding" Value="8,4"/><Setter Property="FontSize" Value="14"/>
   <!-- 既定のフォントの代替では ⚙ が Segoe UI Emoji で大きく描かれる。Chromium と同じ Segoe UI Symbol の字形にする。 -->
   <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
   <Setter Property="Foreground" Value="{DynamicResource Button}"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#4caf50"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
   <Setter Property="FontFamily" Value="Segoe UI, Yu Gothic UI, Meiryo"/>
   <Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6,5"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Field}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="FieldBorder" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <Grid>
     <TextBlock x:Name="Placeholder" Text="{TemplateBinding ToolTip}" Margin="{TemplateBinding Padding}" Foreground="{DynamicResource Muted}" FontSize="12" IsHitTestVisible="False" Visibility="Collapsed"/>
     <ScrollViewer x:Name="PART_ContentHost"/>
     </Grid>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="Text" Value=""><Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="#4caf50"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid>
     <ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
       <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" CornerRadius="4" Padding="6,3">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/></Grid.ColumnDefinitions>
         <ContentPresenter Content="{Binding SelectedItem.Content, RelativeSource={RelativeSource AncestorType=ComboBox}}"/>
         <Path Grid.Column="1" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource Text}" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
       </Border>
      </ControlTemplate></ToggleButton.Template>
     </ToggleButton>
     <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="False" Focusable="False">
      <Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
       <ScrollViewer><ItemsPresenter/></ScrollViewer>
      </Border>
     </Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Field}"/>
   <Setter Property="Padding" Value="6,3"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Item" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource Hover}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="PasswordBox">
   <Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="6,5"/>
   <Setter Property="Foreground" Value="{DynamicResource Text}"/><Setter Property="Background" Value="{DynamicResource Field}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource FieldBorder}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox">
    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox">
   <Setter Property="Width" Value="32"/><Setter Property="Height" Value="18"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Border x:Name="Track" Background="#747775" CornerRadius="9">
     <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="#4caf50"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Text}"/><Setter TargetName="Track" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <DataTemplate DataType="{x:Type vm:MeterViewModel}">
   <StackPanel x:Name="Meter" Margin="0,0,0,8">
    <Grid x:Name="MeterRow" Margin="0,0,0,4">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="MeterLabel" Text="{Binding Label}" ToolTip="{Binding Label}" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" FontSize="12" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
     <TextBlock x:Name="MeterValue" Grid.Column="1" Text="{Binding Value}" Foreground="{Binding Color}" FontSize="13" FontWeight="Bold"/>
    </Grid>
    <Grid x:Name="Bar" Height="6" SizeChanged="OnBarSizeChanged" Tag="{Binding Fraction}">
     <Border Background="{DynamicResource Track}" CornerRadius="3"/>
     <Border x:Name="Fill" Background="{Binding Color}" CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
    </Grid>
    <TextBlock x:Name="Reset" Text="{Binding Reset}" Foreground="{DynamicResource Muted}" FontSize="10" LineHeight="12" Margin="0,3,0,0"/>
   </StackPanel>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Compact}" Value="True">
     <Setter TargetName="Meter" Property="Margin" Value="0,0,0,6"/><Setter TargetName="MeterRow" Property="Margin" Value="0,0,0,3"/>
     <Setter TargetName="MeterLabel" Property="FontSize" Value="11"/><Setter TargetName="MeterValue" Property="FontSize" Value="11"/>
     <Setter TargetName="Bar" Property="Height" Value="4"/><Setter TargetName="Reset" Property="FontSize" Value="9"/><Setter TargetName="Reset" Property="LineHeight" Value="11"/><Setter TargetName="Reset" Property="Margin" Value="0,2,0,0"/>
    </DataTrigger>
    <DataTrigger Binding="{Binding Reset}" Value=""><Setter TargetName="Reset" Property="Visibility" Value="Collapsed"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
  <DataTemplate DataType="{x:Type vm:ServiceViewModel}">
   <Border Background="{DynamicResource Panel}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12">
    <StackPanel>
     <Grid Margin="0,0,0,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <Ellipse Width="10" Height="10" Fill="{Binding Brand}" Margin="0,0,8,0"/>
       <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"/>
       <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Grid.Column="1" Style="{StaticResource IconButton}" ToolTip="{Binding LoginTooltip}" Click="OnLogin" AutomationProperties.Name="{Binding LoginTooltip}">
       <Grid Width="16" Height="17">
        <Viewbox x:Name="Key"><Canvas Width="20" Height="20" RenderTransformOrigin=".5,.5">
         <Canvas.RenderTransform><ScaleTransform ScaleY="-1"/></Canvas.RenderTransform>
         <Path Fill="#ffc83d" Stroke="#be8a0b" StrokeThickness=".8" Data="M 5,11 L 15,1 L 18,4 L 16,6 L 18,8 L 16,10 L 14,8 L 11,11 L 10,15 Z"/>
         <Ellipse Width="9" Height="9" Canvas.Left="1" Canvas.Top="10" Fill="#ffc83d" Stroke="#be8a0b" StrokeThickness="1"/>
         <Ellipse Width="3" Height="3" Canvas.Left="4" Canvas.Top="13" Fill="{DynamicResource Panel}"/>
         <Path Stroke="#ffe899" StrokeThickness="1" Data="M 7,11 L 15,3"/>
        </Canvas></Viewbox>
       </Grid>
      </Button>
     </Grid>
     <TextBlock x:Name="Loading" Text="取得中…" FontSize="12" Foreground="{DynamicResource Muted}" Visibility="Collapsed"/>
     <TextBlock x:Name="Plan" Text="{Binding Plan}" FontSize="10" LineHeight="12" Foreground="{DynamicResource Muted}" Margin="0,-2,0,8"/>
     <Border x:Name="Error" Background="{DynamicResource ErrorBg}" BorderBrush="{DynamicResource ErrorBorder}" BorderThickness="3,0,0,0" CornerRadius="4" Padding="10,8" Visibility="Collapsed">
      <StackPanel>
       <TextBlock Text="{Binding ErrorTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ErrorTitle}" Margin="0,0,0,4"/>
       <TextBlock Text="{Binding ErrorMessage}" FontSize="11" LineHeight="14" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding ErrorHint}" FontSize="11" LineHeight="14" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap">
        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
         <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger>
         <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed"/></Trigger>
        </Style.Triggers></Style></TextBlock.Style>
       </TextBlock>
      </StackPanel>
     </Border>
     <ItemsControl ItemsSource="{Binding Meters}" Loaded="OnMetersLoaded"/>
     <ItemsControl ItemsSource="{Binding Credits}">
      <ItemsControl.ItemTemplate><DataTemplate>
       <Border BorderBrush="{DynamicResource FieldBorder}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,8,0,0">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource Label}"/>
         <StackPanel Grid.Column="1" Orientation="Horizontal">
          <TextBlock Text="{Binding Value}" FontSize="12"/>
          <TextBlock Text="{Binding Expiry}" FontSize="10" Foreground="{DynamicResource Muted}" Margin="3,0,0,0" VerticalAlignment="Center"/>
         </StackPanel>
        </Grid>
       </Border>
      </DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding Plan}" Value=""><Setter TargetName="Plan" Property="Visibility" Value="Collapsed"/></DataTrigger>
    <DataTrigger Binding="{Binding Loading}" Value="True"><Setter TargetName="Loading" Property="Visibility" Value="Visible"/></DataTrigger>
    <DataTrigger Binding="{Binding HasError}" Value="True"><Setter TargetName="Error" Property="Visibility" Value="Visible"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <ScrollViewer x:Name="ContentScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="16,14">
   <Grid Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Agent Limit Checker" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <Button x:Name="SettingsButton" Content="⚙" Style="{StaticResource IconButton}" ToolTip="設定" AutomationProperties.Name="設定" Click="OnSettings" Margin="0,0,4,0"/>
     <Button Content="⟳" Style="{StaticResource IconButton}" ToolTip="今すぐ更新" AutomationProperties.Name="今すぐ更新" Click="OnRefresh"/>
    </StackPanel>
   </Grid>
   <ItemsControl ItemsSource="{Binding Services}"/>
   <Button Content="{Binding DefaultLoginLabel}" Style="{StaticResource TextButton}" HorizontalAlignment="Center" Margin="0,0,0,12" Visibility="{Binding ShowDefaultLogin, Converter={StaticResource BoolVisibility}}" Click="OnDefaultLogin"/>
   <Border x:Name="SettingsPanel" Background="{DynamicResource Panel}" CornerRadius="6" Padding="12,10" Margin="0,0,0,12" Visibility="{Binding SettingsOpen, Converter={StaticResource BoolVisibility}}">
    <StackPanel>
     <TextBlock Text="設定" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <Grid Margin="0,0,0,8">
      <TextBlock Text="更新間隔" FontSize="12" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
      <ComboBox x:Name="Interval" HorizontalAlignment="Right" FontSize="12" Padding="6,3" SelectedValuePath="Tag" SelectionChanged="OnInterval" Background="{DynamicResource Field}" Foreground="{DynamicResource Text}" BorderBrush="{DynamicResource FieldBorder}">
       <ComboBoxItem Tag="30">30秒</ComboBoxItem><ComboBoxItem Tag="60">1分</ComboBoxItem><ComboBoxItem Tag="120">2分</ComboBoxItem><ComboBoxItem Tag="300">5分</ComboBoxItem><ComboBoxItem Tag="600">10分</ComboBoxItem>
      </ComboBox>
     </Grid>
     <Grid Margin="0,0,0,8"><TextBlock Text="ログイン時に自動起動" FontSize="12" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
      <CheckBox x:Name="AutoLaunch" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnAutoLaunch" AutomationProperties.Name="ログイン時に自動起動"/>
     </Grid>
     <Border x:Name="NamesGroup" BorderBrush="{DynamicResource FieldBorder}" BorderThickness="0,1,0,0" Margin="0,2,0,8" Padding="0,8,0,0">
      <StackPanel><TextBlock Text="Codex 表示名" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
       <StackPanel x:Name="NameFields"/>
       <TextBlock Text="空にすると既定の名前に戻ります。" FontSize="10" LineHeight="13.5" Foreground="{DynamicResource Muted}"/>
      </StackPanel>
     </Border>
     <Border BorderBrush="{DynamicResource FieldBorder}" BorderThickness="0,1,0,0" Margin="0,2,0,0" Padding="0,8,0,0">
      <StackPanel>
       <TextBlock Text="ntfy 通知" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,2"/>
       <TextBlock Text="Topic URL" FontSize="11" Foreground="{DynamicResource Label}" Margin="0,0,0,4"/>
       <TextBox x:Name="TopicUrl" Tag="topicUrl" ToolTip="https://ntfy.sh/your-topic" LostKeyboardFocus="OnNtfyText" Margin="0,0,0,8" AutomationProperties.Name="Topic URL"/>
       <TextBlock Text="Access token (任意)" FontSize="11" Foreground="{DynamicResource Label}" Margin="0,0,0,4"/>
       <PasswordBox x:Name="AccessToken" LostKeyboardFocus="OnToken" Margin="0,0,0,8" AutomationProperties.Name="Access token (任意)"/>
       <Grid Margin="0,0,0,8"><TextBlock Text="5時間リセットを通知" FontSize="12" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
        <CheckBox x:Name="NotifyFiveHour" Tag="notifyFiveHour" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnNtfySwitch" AutomationProperties.Name="5時間リセットを通知"/>
       </Grid>
       <Grid Margin="0,0,0,8"><TextBlock Text="週次リセットを通知" FontSize="12" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
        <CheckBox x:Name="NotifyWeekly" Tag="notifyWeekly" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnNtfySwitch" AutomationProperties.Name="週次リセットを通知"/>
       </Grid>
       <Grid Margin="0,0,0,8"><TextBlock Text="Codex リセット権の期限を通知" FontSize="12" Foreground="{DynamicResource Label}" VerticalAlignment="Center"/>
        <CheckBox x:Name="NotifyExpiry" Tag="notifyResetCreditsExpiry" Style="{StaticResource Switch}" HorizontalAlignment="Right" Click="OnNtfySwitch" AutomationProperties.Name="Codex リセット権の期限を通知"/>
       </Grid>
       <TextBlock Text="最も早い期限の5時間前に通知します。5時間を切っている場合は、有効期限内ならすぐ通知します。" TextWrapping="Wrap" FontSize="10" LineHeight="13.5" Foreground="{DynamicResource Muted}" Margin="0,0,0,8"/>
       <TextBlock x:Name="NtfyStatus" TextWrapping="Wrap" FontSize="10" LineHeight="13.5" MinHeight="14" Foreground="{DynamicResource Muted}" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </Border>
   <Grid Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="{Binding Footer}" FontSize="11" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    <Button Grid.Column="1" Content="終了" Style="{StaticResource TextButton}" Click="OnQuit"/>
   </Grid>
  </StackPanel>
 </ScrollViewer>
</Window>
