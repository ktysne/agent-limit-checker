<Window x:Class="AgentLimitChecker.App.Views.UpdateAvailableWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        Title="新しいバージョンがあります (Agent Limit Checker)" Width="560" SizeToContent="Height"
        MinWidth="440" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen"
        Background="#f7f7f7"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button"><Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="32"/></Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource ToolbarButtonStyle}"><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </Window.Resources>
    <StackPanel Margin="24,18,24,20">
        <TextBlock Text="新しいバージョンがあります" FontSize="16" FontWeight="SemiBold"
                   Foreground="#202124" TextWrapping="Wrap" Margin="0,0,0,14"/>

        <Border Background="#ffffff" BorderBrush="#d7dce0"
                BorderThickness="1" CornerRadius="6" Padding="16,14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="{Binding CurrentVersionText}" FontSize="13"
                           Foreground="#202124" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NewVersionText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="#202124" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBox Text="{Binding DownloadUrlText, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                         BorderThickness="0" Background="Transparent" Padding="0" Margin="0,8,0,0"
                         TextWrapping="Wrap" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11.5"
                         Foreground="#4f5358"/>
            </StackPanel>
        </Border>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding StageText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="#202124"/>
            <ProgressBar Height="6" Margin="0,8,0,0" Minimum="0" Maximum="100"
                         Value="{Binding ProgressPercent, Mode=OneWay}"
                         IsIndeterminate="{Binding IsProgressIndeterminate, Mode=OneWay}"
                         Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}"/>
            <TextBlock Text="{Binding ProgressText}" FontSize="11.5" Margin="0,4,0,0"
                       Foreground="#4f5358"/>
            <TextBlock Text="{Binding FailureDetail}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"
                       Foreground="#202124"/>
        </StackPanel>

        <TextBlock FontSize="11.5" Foreground="#4f5358" TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="{Binding HintText}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="配布ページを開く" Style="{StaticResource ToolbarButtonStyle}" Width="120"
                    IsEnabled="{Binding IsPrimaryEnabled}"
                    Click="OnOpenBrowserClick"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="{Binding SecondaryButtonText}" Style="{StaticResource ToolbarButtonStyle}" Width="110" Margin="0,0,8,0"
                        IsEnabled="{Binding IsSecondaryEnabled}" Click="OnSecondaryClick"/>
                <Button Content="{Binding PrimaryButtonText}" Style="{StaticResource PrimaryButtonStyle}" Width="120"
                        IsEnabled="{Binding IsPrimaryEnabled}" IsDefault="True" Click="OnPrimaryClick"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
