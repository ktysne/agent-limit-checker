{
  "name": "agent-limit-checker",
  "description": "Windows tray app that shows Claude Code and Codex rate-limit usage. The app itself is in dotnet/; this package holds the release and review tooling.",
  "author": "agent-limit-checker contributors",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test tests/tools/*.test.js",
    "release:generate": "node tools/release-site.js generate",
    "release:check-version": "node --use-system-ca tools/release-site.js check-version",
    "release:upload": "node --use-system-ca tools/release-site.js upload",
    "release:upload:dry": "node --use-system-ca tools/release-site.js upload --dry-run",
    "review:codex": "node tools/cross-review.js codex",
    "review:codex:fix": "node tools/cross-review.js codex --fix",
    "review:claude": "node tools/cross-review.js claude",
    "sync": "node tools/cross-review.sync.js",
    "sync:check": "node tools/cross-review.sync.js --check"
  },
  "devDependencies": {
    "basic-ftp": "^5.3.1"
  }
}
