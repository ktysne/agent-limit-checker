{
  "name": "agent-limit-checker",
  "version": "3.2.0",
  "description": "Windows tray app that shows Claude Code and Codex API rate-limit usage (Windows port of otoha1119/token-checker)",
  "main": "main.js",
  "author": "agent-limit-checker contributors",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "generate-icon": "node scripts/generate-icon.js",
    "test": "node --test \"test/*.test.js\"",
    "review:codex": "node tools/cross-review.js codex",
    "review:codex:fix": "node tools/cross-review.js codex --fix",
    "review:claude": "node tools/cross-review.js claude",
    "sync": "node tools/cross-review.sync.js",
    "sync:check": "node tools/cross-review.sync.js --check",
    "build": "electron-builder --win --x64",
    "release:major": "npm version major -m \"chore: release v%s\"",
    "release:minor": "npm version minor -m \"chore: release v%s\""
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  },
  "build": {
    "appId": "com.agent-limit-checker.app",
    "productName": "AgentLimitChecker",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false
    }
  }
}
